{
  "name": "screenos",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter @screenos/web dev",
    "dev:server": "pnpm --filter @screenos/server dev",
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "vercel-build": "pnpm --filter @screenos/web build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/USER_OR_ORG/screenos.git"
  }
}
